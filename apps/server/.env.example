# Copy this file to apps/server/.env and fill it in — `pnpm dev` loads it via
# `dotenv/config` (see src/index.ts). Local dev default matches
# infrastructure/docker-compose.yml; Railway sets these itself in production
# (PORT is injected automatically, REDIS_URL via a private networking
# variable reference to the Redis service) — dotenv is a no-op there since no
# .env file exists in that environment.
PORT=8080
REDIS_URL=redis://localhost:6379

# From your Clerk application's dashboard (clerk.com) -> API Keys -> Secret
# key. Server-side only, never expose this the way
# VITE_CLERK_PUBLISHABLE_KEY is exposed. Verifies the session token a
# connecting client sends as `?token=` — required, the server throws on
# startup without it. Every identity-bearing command (CreateGame, JoinGame,
# StartGame, TurnTile, SubmitWord) is authorized against a verified Clerk
# session, so there's no supported mode without this set.
CLERK_SECRET_KEY=
