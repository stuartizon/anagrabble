# Copy this file to apps/server/.env and fill it in — `pnpm dev` loads it via
# `dotenv/config` (see src/index.ts). Values below match
# infrastructure/docker-compose.yml's local containers. Railway/Neon set
# REDIS_URL/DATABASE_URL themselves in production (private networking
# variable references) and PORT is injected automatically — dotenv is a
# no-op there since no .env file exists in that environment. REDIS_URL and
# DATABASE_URL are required; the server throws on startup without them
# (no silent localhost fallback — a missing value in production should fail
# loudly, not quietly try to connect to localhost).
PORT=8080
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://anagrabble:anagrabble@localhost:5432/anagrabble

# From your Clerk application's dashboard (clerk.com) -> API Keys -> Secret
# key. Server-side only, never expose this the way
# VITE_CLERK_PUBLISHABLE_KEY is exposed. Verifies the session token a
# connecting client sends as `?token=` — required unless AUTH_MODE=mock
# below, the server throws on startup without it. Every identity-bearing
# command (CreateGame, JoinGame, StartGame, TurnTile, SubmitWord) is
# authorized against a verified Clerk session.
CLERK_SECRET_KEY=

# Set to "mock" to accept any non-empty session token as its own user id,
# with no signature check and no network call to Clerk — the counterpart to
# apps/web's VITE_AUTH_MODE=mock, so a full create/join/play flow works
# fully offline against that mocked frontend. CLERK_SECRET_KEY isn't
# required in this mode. Leave unset in every deployed environment (never
# set in Railway). See docs/decisions.md "Local dev auth: mock provider,
# not a Clerk sandbox".
AUTH_MODE=

# The web app's origin, for CORS on the REST surface (/stats and beyond —
# see docs/decisions.md "REST endpoints beyond /health"). Required, the
# server throws on startup without it. In production this is the deployed
# Vercel origin; locally it's the Vite dev server.
WEB_ORIGIN=http://localhost:5173

# Optional: error reporting (anagrabble#46). Unset locally and in tests —
# with no DSN, src/observability.ts degrades to plain console logging and
# never touches the network, so the server boots fine without it (unlike
# REDIS_URL/CLERK_SECRET_KEY above, which throw). Railway sets these per
# environment: the DSN from the anagrabble-server Sentry project, and
# SENTRY_ENVIRONMENT as "development" or "production" — one project,
# separated by that tag rather than by a project each. See
# docs/decisions.md "Error tracking: Sentry behind a reportError wrapper".
SENTRY_DSN=
SENTRY_ENVIRONMENT=
