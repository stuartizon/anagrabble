# Baked in at build time (Vite). Set to the deployed backend's wss:// URL in
# Vercel's project env vars for Production, ws://localhost:8080 for local
# dev. No default: the app throws on startup if this is unset.
VITE_WS_URL=ws://localhost:8080

# The same backend's HTTP origin (REST endpoints — /stats and beyond), set
# to the deployed backend's https:// URL in Vercel's project env vars for
# Production, http://localhost:8080 for local dev. Long-term this is meant
# to become canonical with VITE_WS_URL derived from it (same service,
# different scheme) — not done yet, see docs/decisions.md. No default: the
# app throws on startup if this is unset.
VITE_API_URL=http://localhost:8080

# From your Clerk application's dashboard (clerk.com) — safe to expose
# client-side, that's what "publishable" means. No default: the app throws
# on startup if this is unset rather than silently rendering a broken page.
# Not required when VITE_AUTH_MODE=mock below.
VITE_CLERK_PUBLISHABLE_KEY=

# Set to "mock" to sign in/out against a local fake instead of Clerk — no
# network calls, works fully offline. Leave unset to use real Clerk (what
# deployed environments do). See docs/decisions.md "Local dev auth: mock
# provider, not a Clerk sandbox".
VITE_AUTH_MODE=
