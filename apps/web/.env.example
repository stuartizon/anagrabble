# WS_URL/API_URL/CLERK_PUBLISHABLE_KEY moved to runtime config — see
# public/env.example.js — since they're read from window.__ENV__, not
# import.meta.env, and are no longer build-time Vite vars. This file now
# only holds the one var that's still genuinely build-time.

# Set to "mock" to sign in/out against a local fake instead of Clerk — no
# network calls, works fully offline. Leave unset to use real Clerk (what
# deployed environments do). See docs/decisions.md "Local dev auth: mock
# provider, not a Clerk sandbox".
VITE_AUTH_MODE=
