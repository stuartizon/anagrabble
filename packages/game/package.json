{
  "name": "@anagrabble/game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:dictionary": "node scripts/build-dictionary.mjs",
    "fetch:wordnet-roots": "node scripts/fetch-wordnet-roots.mjs",
    "fetch:wiktionary-roots": "node scripts/fetch-wiktionary-roots.mjs",
    "merge:dictionary-roots": "node scripts/merge-dictionary-roots.mjs",
    "enrich:dictionary": "pnpm fetch:wordnet-roots && pnpm fetch:wiktionary-roots && pnpm merge:dictionary-roots && pnpm build:dictionary"
  },
  "dependencies": {
    "@anagrabble/protocol": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
